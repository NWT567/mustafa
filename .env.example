# Optional overrides for the built-in demo administrator credentials.
# Do not expose these with a VITE_ prefix.
ADMIN_EMAIL=
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Use a unique random value of at least 32 characters before production.
ADMIN_SESSION_SECRET=

# Only set this to false when previewing a production build over local HTTP.
# ADMIN_COOKIE_SECURE=false
